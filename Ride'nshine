<style>
body { font-family: 'Montserrat', sans-serif; background-color: #000; color: white; scroll-behavior: smooth; overflow-x: hidden; margin:0; padding:0; }
.accent { color: #d6b07d !important; }

/* STICKY HEADER SYSTEM */
header {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 1000;
}

/* NAVIGATION */
nav { 
    background: rgba(0,0,0,0.95); 
    backdrop-filter: blur(10px); 
    border-bottom: 1px solid rgba(214,176,125,0.2); 
    display: flex; 
    justify-content: space-between; 
    align-items: center; 
}
.nav-container { position: absolute; left: 50%; transform: translateX(-50%); display: flex; gap: 2rem; }
.nav-link { cursor: pointer; transition: 0.3s; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; font-size: 0.8rem; color: #666; }
.nav-link.active-tab { color: #d6b07d !important; }
.nav-link:hover { color: #d6b07d; }

/* THINNER FIXED MARQUEE */
.marquee-bar { 
    background: #1a1a1a; 
    border-bottom: 1px solid rgba(214,176,125,0.3); 
    padding: 8px 0; 
    overflow: hidden; 
    width: 100%; 
    position: relative; 
    z-index: 50; 
}
.marquee-content { display: flex; white-space: nowrap; animation: scrollMarquee 15s linear infinite; }
.marquee-item { display: flex; align-items: center; color: #d6b07d; font-weight: 700; text-transform: uppercase; letter-spacing: 2px; font-size: 0.65rem; margin: 0 45px; }
.marquee-item i { margin-right: 8px; font-size: 0.75rem; }
@keyframes scrollMarquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

/* HERO SECTIONS */
.hero { height: 100vh; background: linear-gradient(to bottom, rgba(0,0,0,0) 40%, #000 100%), url('https://images.unsplash.com/photo-1520340356584-f9917d1eea6f?q=80&w=3840') center/cover no-repeat; background-attachment: fixed; display:flex; justify-content:center; align-items:center; text-align:center; }
.hero-standard { height: 60vh; background: linear-gradient(to bottom, rgba(0,0,0,0.4), #000), url('https://images.unsplash.com/photo-1607860108855-64acf2078ed9?q=80&w=3840') center/cover no-repeat; display:flex; justify-content:center; align-items:center; text-align:center; }
.title { font-size: clamp(3rem, 7vw, 7rem); font-weight: 700; letter-spacing: 6px; text-transform: uppercase; position: relative; }
.title::after { content: ""; position: absolute; left: 50%; bottom: -20px; transform: translateX(-50%); width: 120px; height: 3px; background: #d6b07d; }

/* PADDING FOR CONTENT */
.page-content { transition: opacity 0.5s ease; padding-bottom: 100px; padding-top: 130px; }
#homePage { padding-top: 0; }

/* PRICING & SMOOTH HOVERS */
.price-card, .service-card, .glass, .review-card, .size-detail-card { transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1) !important; }
.price-card:hover, .service-card:hover, .review-card:hover, .size-detail-card:hover { transform: translateY(-12px); border-color: #d6b07d; box-shadow: 0 30px 70px rgba(214,176,125,0.25); }
.price-card { background: #0c0c0c; border: 1px solid rgba(214,176,125,0.2); border-radius: 20px; padding: 50px 0; position: relative; overflow: hidden; min-height: 400px; display: flex; flex-direction: column; justify-content: center; }
.price-card h3 { font-size: 1.6rem; margin-bottom: 25px; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
.price-card ul { text-align: left; line-height: 2.2; font-size: 1.1rem; padding: 0 40px;}
.badge { position: absolute; top: 25px; right: -45px; background: #d6b07d; color: black; padding: 8px 45px; transform: rotate(45deg); font-size: 0.8rem; font-weight: 900; text-transform: uppercase; }

.service-card { background: #0c0c0c; border: 1px solid rgba(214,176,125,0.2); padding: 50px !important; }

/* SIZE GUIDE RESTORED */
.size-detail-card { background: #0c0c0c; border: 1px solid rgba(214,176,125,0.2); border-radius: 20px; padding: 40px; text-align: center; }
.size-icon-display { font-size: 5rem; color: #d6b07d; margin-bottom: 20px; display: block; filter: drop-shadow(0 0 15px rgba(214,176,125,0.3)); }

/* REVIEWS & FAQ */
.review-card { background: #0c0c0c; border: 1px solid rgba(214,176,125,0.1); border-radius: 24px; padding: 30px; position: relative; }
.delete-btn { background: #ff4444; color: white; padding: 4px 10px; border-radius: 5px; font-size: 0.7rem; cursor: pointer; position: absolute; top: 10px; right: 10px; display: none; }
.admin-mode .delete-btn { display: block; }

.faq-item { background: transparent; border: 1px solid rgba(214,176,125,0.1); border-radius: 12px; margin-bottom: 1rem; overflow: hidden; transition: 0.3s; }
.faq-item:hover { border-color: #d6b07d; }
.faq-question { padding: 20px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; font-weight: 600; text-align: left; }
.faq-answer { padding: 0 20px; max-height: 0; overflow: hidden; transition: max-height 0.4s ease, padding 0.4s ease; color: #999; line-height: 1.6; text-align: left; }
.faq-item.active .faq-answer { padding: 0 20px 20px 20px; }
.faq-item.active i { transform: rotate(180deg); color: #d6b07d; }

.glass { background: #0c0c0c; border: 1px solid rgba(214,176,125,0.2); }
input, select, textarea { background: #0c0c0c; border: 1px solid rgba(214,176,125,0.3); padding: 12px; border-radius: 8px; width: 100%; color: white; transition: .3s ease; }
input:focus, select:focus, textarea:focus { outline: none; border-color: #d6b07d; box-shadow: 0 0 15px rgba(214,176,125,0.3); }
.btn-gold { background: #d6b07d; color: black; padding: 12px 24px; border-radius: 8px; font-weight: 600; transition: .3s ease; cursor: pointer; display: inline-block; }
.btn-gold:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(214,176,125,0.4); }

.fade-up { opacity: 0; transform: translateY(50px); transition: opacity 0.8s ease-out, transform 0.8s ease-out; }
.fade-up.show { opacity: 1; transform: translateY(0); }

.hidden-page { display: none; }

#cartPanel { position: fixed; top: 0; right: 0; width: 96%; max-width: 450px; height: 100vh; background: #111; transform: translateX(100%); transition: transform 0.4s ease; overflow-y: auto; padding: 24px; z-index: 1500; box-shadow: -4px 0 20px rgba(214,176,125,0.4); display: flex; flex-direction: column; }
.about-section { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; padding: 60px 10px; max-width: 1200px; margin: auto; }
.about-section img { width: 100%; border-radius: 12px; object-fit: cover; }
.bottom-gradient { position: fixed; bottom: 0; left: 0; width: 100%; height: 300px; background: linear-gradient(to top, rgba(214,176,125,0.4) 0%, rgba(214,176,125,0.1) 40%, transparent 100%); pointer-events: none; z-index: -1; }
footer { position: relative; z-index: 10; background: transparent; }
.easter-egg { opacity: 0.05; transition: 0.5s; cursor: help; padding: 10px; font-size: 0.7rem; color: #333; }
.easter-egg:hover { opacity: 1; color: #d6b07d; text-shadow: 0 0 8px #d6b07d; }

@media(max-width:768px){ 
    .about-section { grid-template-columns: 1fr; gap: 20px; } 
