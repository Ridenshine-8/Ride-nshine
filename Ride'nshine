function loadFaqs() {
    const container = document.getElementById('faqContainer');
    container.innerHTML = faqs.map((f, i) => `
        <div class="faq-item">
            <div class="faq-question" onclick="toggleFaq(this)"><span>${i+1}. ${f[0]}</span><i class="fa-solid fa-chevron-down"></i></div>
            <div class="faq-answer">${f[1]}</div>
        </div>`).join('');
}

emailjs.init("YOUR_PUBLIC_KEY");
const API_URL = "https://sheetdb.io/api/v1/ydw9usfl2r5u8";
let cart = [], isAdmin = false, eggClicks = 0, selectedRating = 5;

// Star Selector Logic
document.querySelectorAll('#starSelector i').forEach(star => {
    star.onclick = (e) => {
        selectedRating = parseInt(e.target.getAttribute('data-val'));
        document.querySelectorAll('#starSelector i').forEach((s, idx) => {
            s.classList.toggle('fa-solid', idx < selectedRating);
            s.classList.toggle('fa-regular', idx >= selectedRating);
        });
    };
});

async function submitReview() {
    const name = document.getElementById('revName').value;
    const text = document.getElementById('revText').value;
    const file = document.getElementById('revImage').files[0];
    const btn = document.getElementById('submitRevBtn');
    if(!name || !text) return alert("Missing info.");
    
    btn.innerText = "Posting..."; btn.disabled = true;
    let base64 = "";
    if(file) {
        base64 = await new Promise(r => { 
            const reader = new FileReader(); reader.onload = () => r(reader.result); reader.readAsDataURL(file); 
        });
    }

    try {
        await fetch(API_URL, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ data: [{ id: Date.now(), name, rating: selectedRating, text, image: base64, date: new Date().toLocaleDateString() }] })
        });
        confetti({ particleCount: 150, spread: 100 });
        document.getElementById('revName').value = ''; document.getElementById('revText').value = ''; document.getElementById('revImage').value = '';
        renderReviews();
    } catch(e) { alert("Error"); }
    finally { btn.innerText = "Post Review"; btn.disabled = false; }
}

async function deleteReview(id) {
    if(!confirm("Delete?")) return;
    await fetch(`${API_URL}/id/${id}`, { method: 'DELETE' });
    renderReviews();
}

function handleEasterEgg() {
    eggClicks++;
    confetti({ particleCount: 100, spread: 70, origin: { y: 0.9 }, colors: ['#d6b07d', '#ffffff'] });
    if (eggClicks === 5) {
        if (prompt("Admin Code:") === "wearecarslayers6711") {
            isAdmin = true; document.body.classList.add('admin-mode');
            document.getElementById('modBadge').classList.remove('hidden'); renderReviews();
        } else { eggClicks = 0; }
    }
}

function showPage(p) {
    document.querySelectorAll('.page-content').forEach(el => el.classList.add('hidden-page'));
    document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active-tab'));
    document.getElementById(p + 'Page').classList.remove('hidden-page');
    document.getElementById('nav-' + p).classList.add('active-tab');
    window.scrollTo(0,0); triggerAnimations();
    if(p === 'reviews') renderReviews();
}

function triggerAnimations() {
    const obs = new IntersectionObserver((ents) => { ents.forEach(e => { if(e.isIntersecting) e.target.classList.add('show'); }); }, {threshold: 0.15});
    document.querySelectorAll('.fade-up').forEach(el => obs.observe(el));
}

function toggleFaq(el) {
    const item = el.parentElement, ans = item.querySelector('.faq-answer');
    const act = item.classList.contains('active');
    document.querySelectorAll('.faq-item').forEach(i => { i.classList.remove('active'); i.querySelector('.faq-answer').style.maxHeight = null; });
    if (!act) { item.classList.add('active'); ans.style.maxHeight = ans.scrollHeight + "px"; }
}

function toggleCart(o) { document.getElementById('cartPanel').style.transform = o ? 'translateX(0)' : 'translateX(100%)'; }

async function renderReviews() {
    const container = document.getElementById('reviewsContainer');
    try {
        const res = await fetch(API_URL); const data = await res.json();
        container.innerHTML = ''; let t = 0;
        data.forEach(r => {
            t += parseInt(r.rating);
            const imgTag = r.image ? `<img src="${r.image}" class="w-full h-48 object-cover rounded-xl mt-4 border border-gray-800">` : '';
            container.innerHTML += `<div class="review-card fade-up show">${isAdmin ? `<button class="delete-btn" onclick="deleteReview('${r.id}')">Delete</button>` : ''}<div class="flex justify-between mb-4"><span class="font-bold accent">${r.name}</span><span class="text-xs text-gray-600">${r.date}</span></div><div class="text-[#d6b07d] mb-3">${'★'.repeat(r.rating)}${'☆'.repeat(5-r.rating)}</div><p class="text-gray-300 italic">"${r.text}"</p>${imgTag}</div>`;
        });
        document.getElementById('totalReviewsCount').innerText = data.length;
        document.getElementById('avgRatingScore').innerText = data.length ? (t / data.length).toFixed(1) : "0.0";
    } catch(e) {}
}

const prices = {
    exterior: { one: { compact: 25, mid: 30, full: 35, large: 40 }, weekly: { compact: 95, mid: 110, full: 125, large: 140 }, monthly: { compact: 70, mid: 85, full: 100, large: 120 } },
    interior: { one: { compact: 50, mid: 60, full: 70, large: 80 }, weekly: { compact: 180, mid: 220, full: 260, large: 300 }, monthly: { compact: 140, mid: 175, full: 200, large: 230 } },
    combo: { one: { compact: 70, mid: 80, full: 90, large: 100 }, weekly: { compact: 275, mid: 315, full: 355, large: 395 }, monthly: { compact: 215, mid: 235, full: 265, large: 295 } }
};

function addToCartFromPage() {
    const pack = document.getElementById('package-booking').value;
    const plan = document.getElementById('plan-booking').value;
    const size = document.getElementById('size-booking').value;
    if(!pack || !plan || !size) return alert("Please select all options.");
    cart.push({ pack, plan, size, price: prices[pack][plan][size] }); 
    updateCart(); toggleCart(true);
}

function updateCart() {
    const l = document.getElementById('cartItemsPopup'); let t = 0; l.innerHTML = '';
    cart.forEach((i, x) => { t += i.price; l.innerHTML += `<li class="flex justify-between items-center bg-[#1a1a1a] p-4 rounded-lg"><div><p class="font-bold accent uppercase text-sm">${i.pack} (${i.plan})</p><p class="text-xs text-gray-500">${i.size}</p></div><div class="flex items-center gap-4"><span>$${i.price}</span><button onclick="cart.splice(${x},1);updateCart();" class="text-red-500 text-xs">Remove</button></div></li>`; });
    document.getElementById('totalInline').innerText = `$${t}`;
}

document.getElementById('bookingForm').onsubmit = function(e) {
    e.preventDefault(); if(cart.length === 0) return alert("Empty.");
    emailjs.send("YOUR_SERVICE_ID", "YOUR_TEMPLATE_ID", { from_name: document.getElementById('name').value, items: cart.map(i => `${i.pack} ${i.plan}: $${i.price}`).join(", "), total: document.getElementById('totalInline').innerText })
        .then(() => { cart = []; updateCart(); toggleCart(false); alert("Sent!"); });
};
window.onload = () => { triggerAnimations(); renderReviews(); loadFaqs(); };
</script>
